# =====================================================================
# AGUATECH ENGINEERS PVT. LTD. - INDIAMART AUTOBUY BOT CONFIGURATION
# =====================================================================
# NOTE: Copy this file to '.env' for local runs, or set these variables
# directly in the Railway Variables dashboard for 24/7 cloud deployment.

# --- SAFETY CONTROLS ---
# Keep DRY_RUN_MODE=true for testing! In Dry-Run mode, the bot identifies
# leads and sends Telegram alerts but does NOT spend real account credits.
DRY_RUN_MODE=true

# Polling interval in seconds (0.5 = check twice every second)
POLLING_INTERVAL=0.5

# Maximum leads to purchase per day to protect your wallet balance
MAX_LEADS_PER_DAY=15

# Minimum order quantity to filter out small consumer inquiries (default: 1)
MIN_ORDER_QUANTITY=1

# --- INDIAMART SESSION CREDENTIALS ---
# Your primary or secondary IndiaMART authorized mobile number
ACCOUNT_MOBILE=9876543210

# Active session cookie string extracted from Chrome DevTools (F12) or session_manager.py
# Format: "user_session=abc; glusr_id=123; ..."
INDIAMART_COOKIE=

# User agent string mimicking a standard modern browser
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# --- TELEGRAM NOTIFICATIONS ---
# Your Telegram Bot API Token obtained from @BotFather (e.g., 73829104:AAHj...)
TELEGRAM_BOT_TOKEN=

# Your personal Chat ID (from @userinfobot) OR Group Chat ID (e.g., -100234567890)
TELEGRAM_CHAT_ID=

# --- OPTIONAL WEB DASHBOARD ---
DASHBOARD_PORT=8501
